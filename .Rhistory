library(haven)
library(tidyverse)
# load in and prepare the data
nycschools <- read_dta("https://learndata.net/nycschools.dta")
nycschools <- nycschools |> mutate(iep = parse_number(iep))
nycschools <- nycschools |> mutate(blackhispanic = parse_number(blackhispanic))
nycschools <- nycschools |> mutate(ell = parse_number(ell))
nycschools <- nycschools |> mutate(thgrmathela = parse_number(thgrmathela))
nycschools <- nycschools |> rename(combined_score = thgrmathela)
# run a regression, then show a summary of its results
regression1 <- lm(overallscore ~ combined_score, data = nycschools)
summary(regression1)
# you can also combine the above into a single line
summary(lm(overallscore ~ combined_score, data = nycschools))
summary(lm(overallscore ~ combined_score, data = nycschools))
regression2 <- lm(overallscore ~ combined_score ell iep blackhispanic economicneedindex, data = nycschools)
# three different ways to make the same plot
regression2 <- lm(overallscore ~ combined_score + ell + iep + blackhispanic + economicneedindex, data = nycschools)
summary(regression2)
